# Keep cloud build contexts small, hermetic, and secret-free.
.git/
.vscode/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
node_modules/
frontend/dist/
backend/var/
backend/uploads/
backend/tmp/
var/
# Local/dev env files must NEVER bake into images (Vite would read them).
.env
*.env
!.env.example
**/.env.example
