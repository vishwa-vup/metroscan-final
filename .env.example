# MetroScan environment template — copy to .env and fill in. NEVER commit .env.
APP_ENV=development

# Locked: PostgreSQL (wired in Phase 5; URL validated from Phase 0)
DATABASE_URL=postgresql+psycopg2://metroscan:changeme@localhost:5432/metroscan

# Locked: JWT + RBAC (enforced in Phase 7; secret handling from Phase 0)
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS origins, comma-separated (production frontend domain goes here)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Pipeline tunables (defaults match backend/app/core_config.py)
STORAGE_DIR=backend/var/scans
OCR_CONFIDENCE_THRESHOLD=0.70
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=400
BLUR_THRESHOLD=60.0

# First-login seed (required by backend/deploy/init_db.py before first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Google sign-in (user portal only, optional). Empty = endpoint answers 503.
# Must be the same OAuth Web client ID as VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=
