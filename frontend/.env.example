# MetroScan frontend — copy to .env and adjust. NEVER commit .env.
VITE_API_BASE_URL=http://localhost:8000
# Production example:
# VITE_API_BASE_URL=https://api.metroscan.example.com
# Google sign-in (user portal only, optional). Empty = Google button hidden.
# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID, Web).
# VITE_GOOGLE_CLIENT_ID=
